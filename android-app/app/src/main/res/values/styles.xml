<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_on_surface</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="colorSecondaryContainer">#1D3D72</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="android:colorBackground">@color/brand_background</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <!-- Sora everywhere -->
        <item name="android:fontFamily">@font/sora</item>
        <item name="fontFamily">@font/sora</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Drone.Title</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Drone.Label</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Drone.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Drone.Caption</item>
    </style>

    <style name="AppTheme.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <style name="AppTheme.Settings" parent="android:Theme.Material">
        <item name="android:colorPrimary">@color/brand_surface</item>
        <item name="android:colorPrimaryDark">@color/brand_background</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:colorBackground">@color/brand_background</item>
        <item name="android:windowBackground">@color/brand_background</item>
    </style>

    <!-- Buttons under the video: equal width, icon + label -->
    <style name="ToolButton" parent="Widget.Material3.Button.TonalButton.Icon">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAppearance">@style/TextAppearance.Drone.Label</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/brand_on_surface</item>
        <item name="cornerRadius">10dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">7dp</item>
        <item name="iconGravity">textStart</item>
        <item name="backgroundTint">@color/brand_surface_high</item>
        <item name="iconTint">@color/brand_on_surface</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="CardButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Drone.Label</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@color/brand_surface_high</item>
        <item name="android:textColor">@color/brand_on_surface</item>
    </style>
</resources>
