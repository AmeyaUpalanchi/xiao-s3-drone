<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tools_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/tools_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tools_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/brand_on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/tools_title"
            android:textAppearance="@style/TextAppearance.Drone.Title" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tools_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tools_checking"
            android:textAppearance="@style/TextAppearance.Drone.Caption" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- ================= Left column ================= -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Flying style -->
                <LinearLayout style="@style/Card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/style_title"
                        android:textAppearance="@style/TextAppearance.Drone.Heading" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/style_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/style_beginner"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/style_beginner"
                            android:textAppearance="@style/TextAppearance.Drone.Label"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/style_normal"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/style_normal"
                            android:textAppearance="@style/TextAppearance.Drone.Label"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/style_sport"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/style_sport"
                            android:textAppearance="@style/TextAppearance.Drone.Label"
                            android:textSize="13sp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <TextView
                        android:id="@+id/style_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAppearance="@style/TextAppearance.Drone.Caption" />
                </LinearLayout>

                <!-- Motor test -->
                <LinearLayout style="@style/Card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/motor_title"
                        android:textAppearance="@style/TextAppearance.Drone.Heading" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/motor_warning"
                        android:textAppearance="@style/TextAppearance.Drone.Caption"
                        android:textColor="@color/status_warn" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/motor_front"
                        android:textAppearance="@style/TextAppearance.Drone.Micro" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/motor_4"
                            style="@style/CardButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/motor_4" />

                        <Space android:layout_width="12dp" android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/motor_1"
                            style="@style/CardButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/motor_1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/motor_3"
                            style="@style/CardButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/motor_3" />

                        <Space android:layout_width="12dp" android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/motor_2"
                            style="@style/CardButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/motor_2" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/motor_all"
                        style="@style/CardButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="8dp"
                        android:text="@string/motor_all" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/motor_hint"
                        android:textAppearance="@style/TextAppearance.Drone.Caption" />
                </LinearLayout>

                <!-- Flight controls -->
                <LinearLayout style="@style/Card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/controls_title"
                        android:textAppearance="@style/TextAppearance.Drone.Heading" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/controls_desc"
                        android:textAppearance="@style/TextAppearance.Drone.Caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/open_controls"
                        style="@style/CardButton"
                        android:layout_marginTop="12dp"
                        android:text="@string/controls_open" />
                </LinearLayout>
            </LinearLayout>

            <!-- ================= Right column ================= -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Level calibration -->
                <LinearLayout style="@style/Card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/level_title"
                        android:textAppearance="@style/TextAppearance.Drone.Heading" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/level_desc"
                        android:textAppearance="@style/TextAppearance.Drone.Caption" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/level_run"
                            style="@style/CardButton"
                            android:text="@string/level_run" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/level_reset"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:text="@string/level_reset"
                            android:textAppearance="@style/TextAppearance.Drone.Label"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/level_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.Drone.Caption" />
                </LinearLayout>

                <!-- Find my drone -->
                <LinearLayout style="@style/Card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/find_title"
                        android:textAppearance="@style/TextAppearance.Drone.Heading" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/find_desc"
                        android:textAppearance="@style/TextAppearance.Drone.Caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/find_beep"
                        style="@style/CardButton"
                        android:layout_marginTop="12dp"
                        android:text="@string/find_beep" />
                </LinearLayout>

                <!-- Wi-Fi -->
                <LinearLayout style="@style/Card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wifi_title"
                        android:textAppearance="@style/TextAppearance.Drone.Heading" />

                    <TextView
                        android:id="@+id/wifi_current"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.Drone.Caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/wifi_name_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/wifi_name_hint"
                        app:prefixText="ESP-DRONE_">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/wifi_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_"
                            android:inputType="text"
                            android:maxLength="20"
                            android:textAppearance="@style/TextAppearance.Drone.Body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/wifi_pass_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/wifi_pass_hint"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/wifi_pass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLength="63"
                            android:textAppearance="@style/TextAppearance.Drone.Body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wifi_save"
                        style="@style/CardButton"
                        android:layout_marginTop="12dp"
                        android:text="@string/wifi_save" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/wifi_note"
                        android:textAppearance="@style/TextAppearance.Drone.Caption" />
                </LinearLayout>

                <!-- Firmware update -->
                <LinearLayout style="@style/Card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fw_title"
                        android:textAppearance="@style/TextAppearance.Drone.Heading" />

                    <TextView
                        android:id="@+id/fw_current"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.Drone.Caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fw_choose"
                        style="@style/CardButton"
                        android:layout_marginTop="12dp"
                        android:text="@string/fw_choose" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/fw_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:trackCornerRadius="2dp" />

                    <TextView
                        android:id="@+id/fw_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/fw_note"
                        android:textAppearance="@style/TextAppearance.Drone.Caption" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
