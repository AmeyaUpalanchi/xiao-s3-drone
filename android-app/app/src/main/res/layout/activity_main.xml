<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    tools:ignore="ContentDescription">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/hud_top"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brand_name"
            android:textColor="@color/brand_on_surface"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <se.bitcraze.crazyfliecontrol2.BatteryView
            android:id="@+id/battery_icon"
            android:layout_width="24dp"
            android:layout_height="12dp"
            android:contentDescription="@string/batteryIconContentDescription" />

        <TextView
            android:id="@+id/battery_text"
            style="@style/StatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFeatureSettings="tnum"
            android:text="--%" />

        <TextView
            android:id="@+id/battery_voltage"
            style="@style/TelemetryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="" />

        <ImageView
            android:id="@+id/linkQuality_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="18dp"
            android:contentDescription="@string/linkQualityIconContentDescription"
            android:src="@drawable/ic_wifi"
            app:tint="@color/brand_muted" />

        <TextView
            android:id="@+id/linkQuality_text"
            style="@style/StatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFeatureSettings="tnum"
            android:text="N/A" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/imageButton_connect"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="18dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/menu_connect"
            android:textAllCaps="false"
            android:contentDescription="@string/menu_connect_ContentDescription"
            app:cornerRadius="8dp" />

        <ImageButton
            android:id="@+id/imageButton_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_preferences_ContentDescription"
            android:src="@drawable/ic_settings"
            app:tint="@color/brand_muted" />
    </LinearLayout>

    <!-- Sticks -->
    <com.MobileAnarchy.Android.Widgets.Joystick.JoystickView
        android:id="@+id/joystick_left"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hud_top"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_percent="0.25"
        app:layout_constraintHeight_max="260dp"
        app:layout_constraintDimensionRatio="1:1" />

    <com.MobileAnarchy.Android.Widgets.Joystick.JoystickView
        android:id="@+id/joystick_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hud_top"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_percent="0.25"
        app:layout_constraintHeight_max="260dp"
        app:layout_constraintDimensionRatio="1:1" />

    <ImageButton
        android:id="@+id/joystick_left_hlock"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/custom_button_seledted"
        android:contentDescription="@string/hlock_contentDescription"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_horizontal"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hud_top" />

    <!-- Camera feed from the XIAO ESP32-S3 Sense, centre of the screen -->
    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_video_panel"
        android:clipToOutline="true"
        app:layout_constraintDimensionRatio="4:3"
        app:layout_constraintTop_toBottomOf="@id/hud_top"
        app:layout_constraintBottom_toTopOf="@id/flightdataview"
        app:layout_constraintStart_toEndOf="@id/joystick_left"
        app:layout_constraintEnd_toStartOf="@id/joystick_right">

        <se.bitcraze.crazyfliecontrol2.video.MjpegView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/video_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_videocam_off"
                app:tint="@color/brand_muted" />

            <TextView
                android:id="@+id/video_placeholder_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/video_no_drone"
                android:textColor="@color/brand_on_surface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/video_placeholder_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxWidth="260dp"
                android:text="@string/video_no_drone_hint"
                android:textColor="@color/brand_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/chip_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_overlay_label"
            android:drawableStart="@drawable/dot_green"
            android:drawablePadding="6dp"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="@string/chip_live"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/chip_rec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_overlay_label"
            android:drawableStart="@drawable/dot_red"
            android:drawablePadding="6dp"
            android:fontFeatureSettings="tnum"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="@string/chip_rec"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Pitch / roll / thrust / yaw -->
    <se.bitcraze.crazyfliecontrol2.FlightDataView
        android:id="@+id/flightdataview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/camera_controls"
        app:layout_constraintStart_toStartOf="@id/video_container"
        app:layout_constraintEnd_toEndOf="@id/video_container" />

    <!-- Photo / Record / Live -->
    <LinearLayout
        android:id="@+id/camera_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/joystick_left"
        app:layout_constraintEnd_toStartOf="@id/joystick_right">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_photo"
            style="@style/ToolButton"
            android:text="@string/button_photo"
            app:icon="@drawable/ic_photo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_record"
            style="@style/ToolButton"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/button_record"
            app:icon="@drawable/ic_record"
            app:iconTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_live"
            style="@style/ToolButton"
            android:text="@string/button_live"
            app:icon="@drawable/ic_live" />
    </LinearLayout>

    <!-- Optional console (Settings > App settings > Show console) -->
    <ScrollView
        android:id="@+id/console_scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/stroke_bg"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@id/video_container"
        app:layout_constraintBottom_toBottomOf="@id/video_container"
        app:layout_constraintStart_toStartOf="@id/video_container"
        app:layout_constraintEnd_toEndOf="@id/video_container">

        <TextView
            android:id="@+id/console_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:padding="8dp"
            android:textColor="@color/brand_on_surface"
            android:fontFamily="monospace"
            android:textSize="10sp" />
    </ScrollView>

    <!-- Crazyflie 2 deck actions: not on ESP-Drone, kept hidden for the presenter -->
    <ImageButton android:id="@+id/button_ledRing" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:onClick="switchLedRingEffect" android:src="@drawable/ic_led_ring" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <ImageButton android:id="@+id/button_headLight" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:onClick="toggleHeadlight" android:src="@drawable/ic_headlight" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <ImageButton android:id="@+id/button_buzzerSound" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:onClick="playBuzzerSound" android:src="@drawable/ic_volume_up_black" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
