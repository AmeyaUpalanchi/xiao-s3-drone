<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    tools:ignore="ContentDescription">

    <!-- ===== Top bar: 56dp, 24dp side padding to match the stick margins ===== -->
    <LinearLayout
        android:id="@+id/hud_top"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground"
            android:scaleX="1.5"
            android:scaleY="1.5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/brand_name"
            android:textAppearance="@style/TextAppearance.Drone.Title" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <se.bitcraze.crazyfliecontrol2.BatteryView
            android:id="@+id/battery_icon"
            android:layout_width="24dp"
            android:layout_height="12dp"
            android:contentDescription="@string/batteryIconContentDescription" />

        <TextView
            android:id="@+id/battery_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="--%"
            android:textAppearance="@style/TextAppearance.Drone.Label" />

        <TextView
            android:id="@+id/battery_voltage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text=""
            android:textAppearance="@style/TextAppearance.Drone.Caption" />

        <TextView
            android:id="@+id/flight_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:drawableStart="@drawable/ic_timer"
            android:drawablePadding="5dp"
            android:drawableTint="@color/brand_muted"
            android:text=""
            android:textAppearance="@style/TextAppearance.Drone.Caption"
            android:visibility="gone" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/brand_outline" />

        <ImageView
            android:id="@+id/linkQuality_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/linkQualityIconContentDescription"
            android:src="@drawable/ic_wifi"
            app:tint="@color/brand_muted" />

        <TextView
            android:id="@+id/linkQuality_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="N/A"
            android:textAppearance="@style/TextAppearance.Drone.Label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_arm"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="96dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/button_arm"
            android:textAppearance="@style/TextAppearance.Drone.Label"
            android:textColor="@color/brand_on_surface"
            app:cornerRadius="10dp"
            app:strokeColor="@color/brand_outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/imageButton_connect"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="112dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/menu_connect"
            android:textAppearance="@style/TextAppearance.Drone.Label"
            android:contentDescription="@string/menu_connect_ContentDescription"
            app:cornerRadius="10dp" />

        <ImageButton
            android:id="@+id/button_help"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/help_title"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_help"
            app:tint="@color/brand_muted" />

        <ImageButton
            android:id="@+id/imageButton_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_preferences_ContentDescription"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            app:tint="@color/brand_muted" />
    </LinearLayout>

    <!-- ===== Centre column: video, telemetry, buttons (all share the same width) ===== -->
    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_video_panel"
        android:clipToOutline="true"
        app:layout_constraintDimensionRatio="4:3"
        app:layout_constraintTop_toBottomOf="@id/hud_top"
        app:layout_constraintBottom_toTopOf="@id/camera_controls"
        app:layout_constraintStart_toEndOf="@id/joystick_left"
        app:layout_constraintEnd_toStartOf="@id/joystick_right"
        app:layout_constraintVertical_chainStyle="packed">

        <se.bitcraze.crazyfliecontrol2.video.MjpegView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/video_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_videocam_off"
                app:tint="@color/brand_muted" />

            <TextView
                android:id="@+id/video_placeholder_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/video_no_drone"
                android:textAppearance="@style/TextAppearance.Drone.Heading" />

            <TextView
                android:id="@+id/video_placeholder_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxWidth="280dp"
                android:text="@string/video_no_drone_hint"
                android:textAppearance="@style/TextAppearance.Drone.Caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/flight_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_margin="10dp"
            android:background="@drawable/bg_overlay_label"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textAppearance="@style/TextAppearance.Drone.Label"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/chip_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_overlay_label"
            android:drawableStart="@drawable/dot_green"
            android:drawablePadding="6dp"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/chip_live"
            android:textAppearance="@style/TextAppearance.Drone.Micro"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/chip_rec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_overlay_label"
            android:drawableStart="@drawable/dot_red"
            android:drawablePadding="6dp"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/chip_rec"
            android:textAppearance="@style/TextAppearance.Drone.Micro"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
        <TextView
            android:id="@+id/battery_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="44dp"
            android:background="@drawable/bg_overlay_label"
            android:backgroundTint="@color/status_warn"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textAppearance="@style/TextAppearance.Drone.Label"
            android:textColor="#000000"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Telemetry strip along the bottom of the video -->
        <se.bitcraze.crazyfliecontrol2.FlightDataView
            android:id="@+id/flightdataview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/overlay_dark"
            android:paddingTop="7dp"
            android:paddingBottom="7dp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/camera_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/video_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/video_container"
        app:layout_constraintEnd_toEndOf="@id/video_container">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_photo"
            style="@style/ToolButton"
            android:text="@string/button_photo"
            app:icon="@drawable/ic_photo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_record"
            style="@style/ToolButton"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:text="@string/button_record"
            app:icon="@drawable/ic_record"
            app:iconTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_live"
            style="@style/ToolButton"
            android:text="@string/button_live"
            app:icon="@drawable/ic_live" />
    </LinearLayout>

    <!-- ===== Sticks: centred on the video column, 24dp from the edges ===== -->
    <com.MobileAnarchy.Android.Widgets.Joystick.JoystickView
        android:id="@+id/joystick_left"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/video_container"
        app:layout_constraintBottom_toBottomOf="@id/video_container"
        app:layout_constraintWidth_percent="0.22"
        app:layout_constraintHeight_max="280dp"
        app:layout_constraintDimensionRatio="1:1" />

    <com.MobileAnarchy.Android.Widgets.Joystick.JoystickView
        android:id="@+id/joystick_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/video_container"
        app:layout_constraintBottom_toBottomOf="@id/video_container"
        app:layout_constraintWidth_percent="0.22"
        app:layout_constraintHeight_max="280dp"
        app:layout_constraintDimensionRatio="1:1" />

    <!-- Flight actions on the bottom row, under each stick -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_land"
        style="@style/ToolButton"
        android:layout_width="0dp"
        android:layout_weight="0"
        android:enabled="false"
        android:text="@string/button_land"
        app:icon="@drawable/ic_land"
        app:layout_constraintTop_toTopOf="@id/camera_controls"
        app:layout_constraintBottom_toBottomOf="@id/camera_controls"
        app:layout_constraintStart_toStartOf="@id/joystick_left"
        app:layout_constraintEnd_toEndOf="@id/joystick_left" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_stop"
        style="@style/ToolButton"
        android:layout_width="0dp"
        android:layout_weight="0"
        android:enabled="false"
        android:text="@string/button_stop_motors"
        android:textColor="@color/status_danger"
        app:icon="@drawable/ic_power"
        app:iconTint="@color/status_danger"
        app:strokeColor="@color/status_danger"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="@id/camera_controls"
        app:layout_constraintBottom_toBottomOf="@id/camera_controls"
        app:layout_constraintStart_toStartOf="@id/joystick_right"
        app:layout_constraintEnd_toEndOf="@id/joystick_right" />

    <!-- Yaw lock sits in the empty top-left corner of the left stick's square -->
    <ImageButton
        android:id="@+id/joystick_left_hlock"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_lock_off"
        android:contentDescription="@string/hlock_contentDescription"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_horizontal"
        app:tint="@color/brand_on_surface"
        app:layout_constraintStart_toStartOf="@id/joystick_left"
        app:layout_constraintTop_toTopOf="@id/joystick_left" />

    <!-- Optional console (Settings > App settings > Show console) -->
    <ScrollView
        android:id="@+id/console_scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/stroke_bg"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@id/video_container"
        app:layout_constraintBottom_toBottomOf="@id/video_container"
        app:layout_constraintStart_toStartOf="@id/video_container"
        app:layout_constraintEnd_toEndOf="@id/video_container">

        <TextView
            android:id="@+id/console_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:padding="8dp"
            android:textColor="@color/brand_on_surface"
            android:fontFamily="monospace"
            android:textSize="10sp" />
    </ScrollView>

    <!-- Crazyflie 2 deck actions: not on ESP-Drone, kept hidden for the presenter -->
    <ImageButton android:id="@+id/button_ledRing" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:onClick="switchLedRingEffect" android:src="@drawable/ic_led_ring" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <ImageButton android:id="@+id/button_headLight" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:onClick="toggleHeadlight" android:src="@drawable/ic_headlight" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <ImageButton android:id="@+id/button_buzzerSound" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:onClick="playBuzzerSound" android:src="@drawable/ic_volume_up_black" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
