<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    tools:ignore="ContentDescription,HardcodedText">

    <!-- ===== Live video (full screen, behind everything) ===== -->
    <se.bitcraze.crazyfliecontrol2.video.MjpegView
        android:id="@+id/video_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/video_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.38">

        <ImageView
            android:id="@+id/video_placeholder_icon"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:alpha="0.85"
            android:src="@drawable/ic_drone" />

        <TextView
            android:id="@+id/video_placeholder_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/video_no_drone"
            android:textColor="@color/brand_on_surface"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/video_placeholder_subtitle"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/video_no_drone_hint"
            android:textColor="@color/brand_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ===== Top HUD bar ===== -->
    <View
        android:id="@+id/hud_top_scrim"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_hud_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/hud_bottom_scrim"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_hud_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/hud_top"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_launcher_foreground"
            android:scaleType="centerCrop"
            android:scaleX="1.6"
            android:scaleY="1.6" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_name"
                android:textColor="@color/brand_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

            <TextView
                android:id="@+id/drone_subtitle"
                style="@style/HudCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_product" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/chip_live"
            style="@style/HudChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_live"
            android:text="@string/chip_live"
            android:visibility="gone" />

        <TextView
            android:id="@+id/chip_rec"
            style="@style/HudChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_rec"
            android:text="@string/chip_rec"
            android:fontFeatureSettings="tnum"
            android:visibility="gone" />

        <!-- Battery -->
        <LinearLayout
            android:id="@+id/battery_group"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <se.bitcraze.crazyfliecontrol2.BatteryView
                android:id="@+id/battery_icon"
                android:layout_width="26dp"
                android:layout_height="13dp"
                android:contentDescription="@string/batteryIconContentDescription" />

            <TextView
                android:id="@+id/battery_text"
                style="@style/HudLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minWidth="36dp"
                android:fontFeatureSettings="tnum"
                android:text="--%"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/battery_voltage"
                style="@style/HudCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFeatureSettings="tnum"
                android:text="" />
        </LinearLayout>

        <!-- Link quality -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/linkQuality_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/linkQualityIconContentDescription"
                android:src="@drawable/ic_link"
                app:tint="@color/brand_secondary" />

            <TextView
                android:id="@+id/linkQuality_text"
                style="@style/HudLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minWidth="30dp"
                android:fontFeatureSettings="tnum"
                android:text="N/A" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/imageButton_connect"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/custom_button"
            android:contentDescription="@string/menu_connect_ContentDescription"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_action_import_export"
            app:tint="@color/brand_on_surface" />

        <ImageButton
            android:id="@+id/imageButton_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/custom_button"
            android:contentDescription="@string/menu_preferences_ContentDescription"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_action_settings_light"
            app:tint="@color/brand_on_surface" />
    </LinearLayout>

    <!-- ===== Joysticks ===== -->
    <com.MobileAnarchy.Android.Widgets.Joystick.JoystickView
        android:id="@+id/joystick_left"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hud_top"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_percent="0.30"
        app:layout_constraintHeight_max="300dp"
        app:layout_constraintDimensionRatio="1:1" />

    <com.MobileAnarchy.Android.Widgets.Joystick.JoystickView
        android:id="@+id/joystick_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hud_top"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_percent="0.30"
        app:layout_constraintHeight_max="300dp"
        app:layout_constraintDimensionRatio="1:1" />

    <ImageButton
        android:id="@+id/joystick_left_hlock"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/custom_button_seledted"
        android:contentDescription="@string/hlock_contentDescription"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_horizontal"
        app:tint="@color/brand_on_surface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hud_top" />

    <!-- ===== Camera controls (bottom centre) ===== -->
    <LinearLayout
        android:id="@+id/camera_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/button_photo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_hud_button"
                android:contentDescription="@string/button_photo"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_photo"
                app:tint="@color/brand_on_surface" />

            <TextView
                style="@style/HudCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/button_photo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/button_record"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/bg_record_button"
                android:contentDescription="@string/button_record"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_record" />

            <TextView
                android:id="@+id/button_record_label"
                style="@style/HudCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/button_record" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/button_live"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_hud_button"
                android:contentDescription="@string/button_live"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_live"
                app:tint="@color/brand_on_surface" />

            <TextView
                android:id="@+id/button_live_label"
                style="@style/HudCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/button_live" />
        </LinearLayout>
    </LinearLayout>

    <!-- Flight telemetry pill -->
    <se.bitcraze.crazyfliecontrol2.FlightDataView
        android:id="@+id/flightdataview"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toTopOf="@id/camera_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Console (optional, enabled in settings) -->
    <ScrollView
        android:id="@+id/console_scrollView"
        android:layout_width="240dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/stroke_bg"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/hud_top"
        app:layout_constraintBottom_toTopOf="@id/flightdataview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/console_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:padding="6dp"
            android:textColor="@color/brand_on_surface"
            android:fontFamily="monospace"
            android:textSize="10sp" />
    </ScrollView>

    <!-- Crazyflie 2 deck actions: not available on ESP-Drone, kept for the presenter -->
    <ImageButton
        android:id="@+id/button_ledRing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:onClick="switchLedRingEffect"
        android:src="@drawable/ic_led_ring"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/button_headLight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:onClick="toggleHeadlight"
        android:src="@drawable/ic_headlight"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/button_buzzerSound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:onClick="playBuzzerSound"
        android:src="@drawable/ic_volume_up_black"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
