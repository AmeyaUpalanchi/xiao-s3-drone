<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/hud_button_pressed" />
            <stroke android:width="1.5dp" android:color="@color/brand_primary" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/hud_scrim_light" />
            <stroke android:width="1dp" android:color="@color/hud_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/hud_button" />
            <stroke android:width="1dp" android:color="@color/hud_stroke" />
        </shape>
    </item>
</selector>
