{
  "name": "tdc-drone-desktop",
  "productName": "TDC Drone",
  "version": "1.0.0",
  "description": "Desktop tool for The Drone Community XIAO S3 drone: firmware updates, USB flashing and bench tools",
  "main": "src/main.js",
  "author": "The Drone Community",
  "license": "GPL-3.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "mock": "node dev/mock-drone.js",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac -c.mac.identity=null",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.thedronecommunity.desktop",
    "productName": "TDC Drone",
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/esptool-js/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "esptool-js": "^0.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
