# ---- Seeed XIAO ESP32-S3 (Sense) on The Drone Community drone PCB1 ----
CONFIG_FREERTOS_UNICORE=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

# 8 MB QIO flash, 8 MB octal PSRAM (camera frame buffers live in PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# Two OTA slots (partitions.csv) for wireless firmware updates from the app
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y

# Console on the XIAO USB-C (native USB Serial/JTAG).
# UART0 RX (GPIO44 = D7) drives motor 2 on this PCB, so UART0 must stay free.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Two small HTTP servers (status/photo on :80, MJPEG on :81) + CRTP UDP
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Board selection
CONFIG_TARGET_ESP32_S2_DRONE_V1_2=y
CONFIG_XIAO_ESP32S3_BOARD=y
CONFIG_MOTOR_BRUSHED_720=y
# CONFIG_BUZZER_ON is not set
CONFIG_DRONE_CAMERA=y
CONFIG_DRONE_CAM_FRAME_VGA=y
CONFIG_DRONE_CAM_JPEG_QUALITY=12
CONFIG_DRONE_CAM_MAX_FPS=20

# esp32-camera: run its DMA task on core 0 next to Wi-Fi, keep core 1 for flight
CONFIG_CAMERA_CORE0=y

# Drone web API (status, tools, firmware upload)
CONFIG_HTTPD_MAX_URI_LEN=512
